# ─────────────────────────────────────────────────────────────────────────────
# FlowCanvas — environment configuration
#
# Copy this file to `.env` and adjust the values. `.env` is git-ignored and must
# never be committed: it is the only place real credentials belong.
#
#   cp .env.example .env
#
# Every variable below has a safe default, so the application runs with NO .env
# at all — the mock AI provider needs no credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/flowcanvas
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ─── Backend ─────────────────────────────────────────────────────────────────
SERVER_PORT=8080
LOG_LEVEL=INFO

# ─── AI provider ─────────────────────────────────────────────────────────────
# mock   → deterministic, fully offline, no credentials required (default)
# openai → any OpenAI-compatible /chat/completions endpoint
AI_PROVIDER=mock

# Only required when AI_PROVIDER=openai.
# Leave blank for the mock provider. Never commit a real key.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
# Retries for 429, 5xx and network errors, with exponential backoff.
AI_MAX_RETRIES=2
# Simulated latency per mock model call (ms), so live run progress is visible.
AI_MOCK_LATENCY_MS=600

# ─── Execution ───────────────────────────────────────────────────────────────
EXECUTION_MAX_CONCURRENT=4
EXECUTION_QUEUE_CAPACITY=64

# ─── Seeding ─────────────────────────────────────────────────────────────────
# Seeds four example workflows on first start (only when the table is empty).
SEED_EXAMPLES=true

# ─── Frontend ────────────────────────────────────────────────────────────────
# The dev server proxies /api to the backend, so this is usually not needed.
VITE_PROXY_TARGET=http://localhost:8080
# Absolute API base URL, for deployments where the frontend and API are on
# different origins. Leave blank to use same-origin requests.
VITE_API_BASE_URL=
