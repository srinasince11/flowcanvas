<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings used only by CI.

  GitHub's hosted runners share IP addresses, and Maven Central rate-limits them
  from time to time ("429 Too Many Requests"), which fails a build before a single
  test runs. CI therefore downloads from Google's public mirror of Maven Central,
  which serves the same artifacts. Local builds and Docker images use Central as usual.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google mirror of Maven Central</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
